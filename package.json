{
  "name": "soundspace",
  "private": true,
  "version": "1.0.0",
  "description": "A browser-based AI-assisted digital audio workstation.",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
