# VITE_GEMINI_API_KEY: Required for client-side Gemini AI features.
# Vite exposes VITE_* variables to the browser, so restrict this key by domain
# before deploying publicly. GEMINI_API_KEY is also supported for AI Studio.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
